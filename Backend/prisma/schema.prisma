generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum AccountType {
  SYSTEM_ADMIN
  PATIENT
  CLINIC_STAFF
}

enum ClinicRole {
  CLINIC_ADMIN
  DOCTOR
  ATTENDANT
}

enum AccountStatus {
  ACTIVE
  PENDING_ACTIVATION 
  SUSPENDED
}

enum ClinicStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  phone              String        @unique 
  phoneVerifiedAt    DateTime?
  passwordHash       String?      
  mustChangePassword Boolean       @default(false)
  accountType        AccountType
  status             AccountStatus @default(ACTIVE)

  patientInfo     PatientInfo?
  doctorInfo      DoctorInfo?
  attendantInfo   AttendantInfo?
  membership      ClinicMembership?
  refreshTokens   RefreshToken[]
  reviewedClinics ClinicInfo[]      @relation("ClinicReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicInfo {
  id      String       @id @default(uuid()) @db.Uuid
  name    String
  address String?
  phone   String?
  status  ClinicStatus @default(PENDING_APPROVAL)

  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?

  reviewedBy  User?              @relation("ClinicReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  memberships ClinicMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientInfo {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorInfo {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @unique @db.Uuid
  specialization String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendantInfo {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClinicMembership {
  id       String     @id @default(uuid()) @db.Uuid
  userId   String     @unique @db.Uuid 
  clinicId String     @db.Uuid
  role     ClinicRole

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic ClinicInfo @relation(fields: [clinicId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([clinicId, role])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid 
  tokenHash String    @unique  
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}